<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist (GENERATE_INFOPLIST_FILE=YES).
	     Values come from build settings; scripts/install-local.sh and CI pass
	     OTTERTWIN_GIT_SHA / OTTERTWIN_BUILD_DATE on the xcodebuild command line. -->
	<key>OTGitSHA</key>
	<string>$(OTTERTWIN_GIT_SHA)</string>
	<key>OTBuildDate</key>
	<string>$(OTTERTWIN_BUILD_DATE)</string>
</dict>
</plist>
