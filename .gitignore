# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode
*.xcuserstate
*.xcscmblueprint
xcuserdata/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
build/

# Swift Package Manager
.build/
.swiftpm/

# Claude Code
.claude/

/tasks/
# Generated Xcode project (run `xcodegen generate`). Only the SwiftPM lockfile is
# tracked so dependency versions stay reproducible.
/OtterTwin.xcodeproj/*
!/OtterTwin.xcodeproj/project.xcworkspace/
/OtterTwin.xcodeproj/project.xcworkspace/*
!/OtterTwin.xcodeproj/project.xcworkspace/xcshareddata/
/OtterTwin.xcodeproj/project.xcworkspace/xcshareddata/*
!/OtterTwin.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
/OtterTwin.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!/OtterTwin.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
